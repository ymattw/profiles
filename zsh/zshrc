# Matt Wang's zsh profile for general Linux/Unix
#
# Implementation notes:
#
# - Functions with name starts with '__' are considered 'private' and will be
#   unset at the end.
# - Functions with name starts with only one '_' are considered 'protected',
#   users can implement their own to override (via ~/.profiles.d).

# Example usage:
#   vif                       # pick files from ~/.fzf-file-list, send to vim
#   vif path [...]            # pick files from path..., send to vim
#   vif | cmd                 # pick files from ~/.fzf-file-list, send to cmd
#   vif path [...] | xargs .. # pick files from path..., send to xargs cmd
#   hg ls | vif               # pick files from commd output, send to vim
function vif {
    if [[ $EDITOR == nvim ]]; then
        local arg=(--bind "enter:become(nvim -n {})")
    else
        local arg=(--bind "enter:become(vim -Xn -u ~/.vimrc {})")
    fi
    [[ -t 1 ]] || arg=()
    if [[ -t 0 ]]; then
        if (( $# > 0 )); then
            find "$@" -type f | fzf "${arg[@]}"
        else
            fzf "${arg[@]}" < ~/.fzf-file-list
        fi
    else
        fzf "${arg[@]}"
    fi
}

# "Protected" helper to decorate CWD used to setup PROMPT
function _source_control_cwd
{
    echo "%~"
}

# "Protected" helper to decorate source control information used to setup
# PROMPT, by default this only detect active git branch information. User can
# extend this to detect other version control system.
#
function _source_control_info
{
    local status_out

    status_out=$(GIT_CEILING_DIRECTORIES=$HOME git --no-optional-locks status -sb 2>/dev/null) || return 0
    _git_active_branch "$status_out"
}

function _git_active_branch
{
    local status_out=${1:-$(GIT_CEILING_DIRECTORIES=$HOME git --no-optional-locks status -sb 2>/dev/null)}
    local header=${status_out%%$'\n'*}
    local info=${status_out#"$header"}
    info=${info#$'\n'}

    local branch=${header#\#\# }
    branch=${branch#No commits yet on }
    branch=${branch%%...*}
    branch=${branch%% *}

    local age track
    if [[ -n $branch && $branch != HEAD \
        && $header != '## No commits yet on '* \
        && $header != '## Initial commit on '* ]]; then
        age=$(git log --pretty=format:'%cr' -1 "refs/heads/$branch" 2>/dev/null)
    fi
    local track_re='\[(.*)\]'
    # match[1] holds the first captured group from zsh's =~ regex match
    [[ $header =~ $track_re ]] && track=", ${match[1]}"

    local nl=$'\n'
    local untracked_re="(^|${nl})([^?]|[?][^?])"
    if [[ -z $info ]]; then
        print -nP "%F{green}"
    elif [[ ! $info =~ $untracked_re ]]; then
        print -nP "%F{magenta}"
    else
        print -nP "%F{red}"
    fi

    print -n " (${branch//\%/%%}) "  # No '-P' and escape '%' for prompt_subst
    print -nP "%F{cyan}[${age}${track}]"
}

function __main
{
    local fn

    for fn in \
        __init_completion \
        __setup_path \
        __setup_shell_options \
        __setup_environments \
        __setup_aliases \
        __setup_completions \
        __setup_dir_colors \
        __setup_ssh_agent \
        __setup_prompt \
        __setup_custom_profiles \
    ; do
        $fn; unset -f $fn
    done
}

function __init_completion
{
    [[ ! -d ~/.zsh-completions ]] || fpath=(~/.zsh-completions/src $fpath)
    autoload -Uz compinit
    local dump=(~/.zcompdump(N.mh+24))
    if (( $#dump )) || [[ ! -f ~/.zcompdump ]]; then
        compinit
    else
        compinit -C
    fi
}

function __setup_path
{
    typeset -gU path
    local d dirs=()

    for d in \
        ~/bin \
        ~/.local/bin \
        /opt/homebrew/bin \
        /usr/local/bin \
        /usr/bin \
        /bin \
        /usr/sbin \
        /sbin \
    ; do
        [[ -d $d ]] && dirs+=("$d")
    done

    path=($dirs $path)
    export PATH
}

function __setup_shell_options
{
    setopt shwordsplit                  # ARG="foo bar"; $ARG => "foo" "bar"
    setopt prompt_subst
    setopt interactive_comments
    setopt nocase_glob
    setopt nocase_match 2>/dev/null     # does not work for zsh < 4.3
    setopt extended_history
    setopt hist_expire_dups_first
    setopt hist_ignore_dups
    setopt hist_ignore_space
    setopt hist_find_no_dups
    setopt hist_verify
    setopt share_history
    setopt auto_pushd
    setopt pushd_ignore_dups
    unsetopt nomatch
    unsetopt correct
    bindkey -e                          # Reclaim C-a, C-e, C-r, M-., etc.
    ! test -t 0 || stty stop undef      # Make 'C-s' to do fwd-i-search
    bindkey "^U" backward-kill-line     # Keep the same behavior as in bash
}

function __setup_environments
{
    HISTFILE=~/.zhistory                # Prevent from ~/.zsh<tab> completion
    HISTSIZE=10000
    SAVEHIST=10000
    export EDITOR=vi
    if command -v nvim >& /dev/null; then
        export EDITOR=nvim
    elif command -v vim >& /dev/null; then
        export EDITOR=vim
    fi

    # Locale (LC_*) matters for ls and sort on Linux, see also
    # www.gnu.org/software/coreutils/faq/#Sort-does-not-sort-in-normal-order_0021
    #
    [[ $OSTYPE != linux* ]] || export LC_COLLATE=C
}

function __setup_completions
{
    zstyle ':completion:*' menu yes select
    zstyle ':completion:*' users off
    zmodload zsh/complist
    bindkey -M menuselect '^M' .accept-line     # <Enter> only once to accept
    ZLE_REMOVE_SUFFIX_CHARS=                    # no space after, zshparam(1)
}

function __setup_aliases
{
    alias ..='cd ..'
    alias ...='cd ../..'
    alias ....='cd ../../..'
    alias .....='cd ../../../..'
    # Skip system wide vimrc to reduce startup time
    if [[ $EDITOR == nvim ]]; then
        alias vi='nvim'
    elif [[ $EDITOR == vim ]]; then
        alias vi='vim -Xn -u ~/.vimrc'
    fi
    alias grep='grep --color=auto'
    alias ls="/bin/ls -F --color=auto"
    alias l="/bin/ls -lF --color=auto"

    case $OSTYPE in
        darwin*)
            export LSCOLORS="exgxfxfxcxdxdxbxbxcxbx"
            alias lsps='ps -ax -o user,pid,ppid,stime,tty,time,command | grep -vw grep | grep -i'
            ;;
        *)
            alias lsps='ps -ef | grep -vw grep | grep -i'
            ;;
    esac
}

function __setup_dir_colors
{
    local prog=dircolors

    [[ $OSTYPE != darwin* ]] || prog=gdircolors
    if type $prog >& /dev/null && [[ -f ~/.dircolors ]]; then
        eval "$($prog -b ~/.dircolors)"
    fi
}

function __setup_ssh_agent
{
    # Keep personal ssh-agent on a dedicated socket inside ~/.ssh/ without
    # modifying global $SSH_AUTH_SOCK (safe alongside corp SSH agents).
    # Key is unlocked lazily on first ssh via AddKeysToAgent in ~/.ssh/config.
    # See ../ssh/README.md and ../ssh/config.sample.
    local key=~/.ssh/$USER.key
    local sock=~/.ssh/agent.sock

    [[ -f $key ]] || return 0

    # ssh-add -l exits: 0=keys loaded, 1=agent alive (no keys), 2=unreachable
    SSH_AUTH_SOCK=$sock /usr/bin/ssh-add -l >& /dev/null
    if (( $? == 2 )); then
        print -P "%F{red}Starting a new personal ssh-agent process...%f" >&2
        rm -f "$sock"
        /usr/bin/ssh-agent -a "$sock" > /dev/null
    fi
}

# Fancy PROMPT, prompt exit status of last command, currenet time, hostname,
# time, cwd, git status and branch, also prompt the '%' in reverse color when
# we have background jobs. NOTE: some symbols may not show correctly inside
# tmux, run tmux with option "-u" should fix it.
#
# Refs:
# - https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html
# - https://zsh.sourceforge.io/Doc/Release/Zsh-Line-Editor.html#Special-Widgets
#
function __setup_prompt
{
    local distro os_icon

    if [[ $OSTYPE == darwin* ]]; then
        os_icon=$'\xef\x85\xb9' # macOS (U+F179)
    else
        if [[ -r /etc/os-release ]]; then
            local k v
            while IFS='=' read -r k v; do
                [[ $k == ID ]] && { distro=${v//\"/}; break; }
            done < /etc/os-release
        fi

        # Match the distro ID to a Nerd Font icon
        # Ref: https://www.nerdfonts.com/cheat-sheet
        case "$distro" in
            debian) os_icon=$'\xef\x8c\x86' ;; # U+F306
            ubuntu) os_icon=$'\xef\x8c\x9b' ;; # U+F31B
            *)      os_icon=$'\xef\x8c\x9a' ;; # Linux Tux (U+F31A)
        esac
    fi

    PROMPT="%(?.%F{green}✔.%F{red}✘) %D{%T}%f "   # exit code and time
    PROMPT+="%F{yellow}\$(_source_control_cwd)%f" # yellow cwd
    PROMPT+="\$(_source_control_info)"            # vcs info
    PROMPT+=" %F{cyan}"$'⤾%f\n'                   # cyan wrap char+NL
    PROMPT+="%F{118}${os_icon} "                  # hilight OS icon
    if [[ -z ${_IS_SUDOER:-} ]]; then
        [[ $(sudo -nv 2>&1) =~ "^$|password" ]] && export _IS_SUDOER=1 || export _IS_SUDOER=0
    fi
    (( _IS_SUDOER )) || {
        PROMPT+="%F{yellow}%n@%F{118}"            # user (non sudoer)
    }
    PROMPT+="%m%f"                                # hostname

    PROMPT+=" %(1j.%S.)"                          # reverse bg job indicator
    PROMPT+="%B%#%s "                             # bold % or #, unreverse

    # Reset color when finished reading a cmd line
    function __zle_line_finish { echo -ne '\e[0m'; }
    zle -N zle-line-finish __zle_line_finish
}

# Load custom settings from ~/.profiles.d/*.sh, typical settings are
# docker-machine env, GOPATH, customized PATH etc.
#
function __setup_custom_profiles
{
    local p

    for p in ~/.profiles.d/*.sh(N); do
        source "$p"
    done
}

########################################################################
# Setup everything and unset the rest "private" functions
########################################################################

__main
unset -f __main

